# SWD-Bench 复现 - 环境变量样例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，勿提交）

# GitHub Personal Access Token（PR 爬取，177.4k PR 需认证配额）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 统一 OpenAI 兼容 LLM 端点
# 默认指向阿里云百炼（dashscope OpenAI 兼容模式），可用 GLM-5.2
# 也可改成任意 OpenAI 兼容服务（DeepSeek/Qwen/OpenAI 等）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 生成功能描述用哪个模型（默认 GLM-5.2，对齐本机可用模型）
# 原论文用 Claude-Sonnet-4，本复现改用 GLM-5.2（见 README 差异表）
DESC_MODEL=glm-5.2

# 数据输出目录
DATA_DIR=./data
