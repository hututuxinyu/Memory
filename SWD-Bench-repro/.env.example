# SWD-Bench 复现 - 环境变量样例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，勿提交）

# GitHub Personal Access Token（PR 爬取必需，177.4k PR 需认证配额）
# 任意 fine-grained token + public_repo 读权限即可
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Anthropic API Key（生成功能描述，对齐原版 Claude-Sonnet-4）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 当 "开发者" 答题用哪个模型（默认对齐原版 GPT-4.1 / Gemini-2.5-Pro，可按预算换）
# 留空则评测 runner 用 OPENAI_API_KEY / GOOGLE_API_KEY（如提供）
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 数据输出目录
DATA_DIR=./data
